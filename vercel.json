{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/shop-templates/(.*)",
      "dest": "/public/shop-templates/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/admin-panel/(.*)",
      "dest": "/public/admin-panel/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server/server.js"
    }
  ]
}